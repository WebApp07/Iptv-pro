# ---------------------------------------------------------------------------
# Sanity CMS
# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in your own values.
#
# Get these values from https://manage.sanity.io -> your project -> API.
#
# These two are public (safe to expose) and are read by both the Studio and
# the Next.js frontend. NEXT_PUBLIC_ prefix makes them available in the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: pin a specific Sanity API version (format YYYY-MM-DD).
# Defaults to a recent version when omitted.
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-01

# Optional: an API token with "write" access, used ONLY by the seed script
# (scripts/seed-blog.mjs) to import the sample articles. Do not prefix with
# NEXT_PUBLIC_ and never expose it to the browser. Create it under
# manage.sanity.io -> API -> Tokens.
SANITY_API_TOKEN=

# Optional: a read-only token for the website itself. Needed if your dataset
# has "Public" access turned off in manage.sanity.io; harmless otherwise.
# Server-side only - it is never sent to the browser.
# SANITY_API_READ_TOKEN=

# ---------------------------------------------------------------------------
# Sports data (server-side only)
# ---------------------------------------------------------------------------
# Provider: API-Sports (https://www.api-sports.io), football product.
# Create a free account to get a key. Never prefix with NEXT_PUBLIC_ - this
# key is read exclusively by server code and is never sent to the browser.
#
# Without a key the sports pages render empty states instead of failing.
# SPORTS_API_KEY=
# Optional: point at another API-Sports sport product host, e.g.
# https://v1.basketball.api-sports.io . Defaults to the football product.
# SPORTS_API_HOST=https://v3.football.api-sports.io
# Optional: request timeout in milliseconds. Defaults to 8000.
# SPORTS_API_TIMEOUT_MS=8000
#
# Alternative gateway: the same football API is also sold on RapidAPI
# (https://rapidapi.com/api-sports/api/football). Subscribing there gives
# an independent quota pool from your direct api-sports.io account:
# SPORTS_API_HOST=https://api-football-v1.p.rapidapi.com/v3
# SPORTS_API_AUTH=rapidapi
# SPORTS_API_KEY=<your RapidAPI key>
#
# Multi-sport provider: AllSportsAPI (https://allsportsapi.com).
# Set SPORTS_PROVIDER=allsports to switch. Each sport is a SEPARATE
# subscription with its own key - configure any subset and only those
# sports go live (the rest render honest coming-soon states):
# SPORTS_PROVIDER=allsports
# SPORTS_API_KEY_FOOTBALL=<football product key>
# SPORTS_API_KEY_BASKETBALL=<basketball product key>
# SPORTS_API_KEY_TENNIS=<tennis product key>
# SPORTS_API_KEY_CRICKET=<cricket product key>
# SPORTS_API_KEY_HOCKEY=<hockey product key>
# SPORTS_API_KEY_BASEBALL=<baseball product key>
# SPORTS_API_KEY_AMERICAN_FOOTBALL=<american football product key>
# Legacy fallback: a shared SPORTS_API_KEY still activates football alone.
# Optional root override; per-product paths are appended automatically
# (defaults to https://apiv2.allsportsapi.com):
# SPORTS_API_HOST=https://apiv2.allsportsapi.com
#
# Basketball via TheRundown on RapidAPI
# (https://rapidapi.com/therundown/api/therundown). Works alongside any
# SPORTS_PROVIDER - when this key is set, /sports/basketball is served from
# it while football keeps its own source:
# RUNDOWN_API_KEY=8af346f75fmsh5dad70105a17072p1aeca9jsn8e87e78d36c2
# Optional: NBA=4 (default), WNBA=8, NCAAB=5:
# RUNDOWN_SPORT_ID=4

# ---------------------------------------------------------------------------
# Site URL
# ---------------------------------------------------------------------------
# The siteConfig.url value in src/config/site.ts controls canonical URLs and
# the sitemap. Update it to your real production URL before deploying.